---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    title: 'Kolik stojí webové stránky v 2025? Kompletní průvodce cenami',
    description: 'Ceny webů se pohybují od 3 000 do 300 000 Kč. Jak se v tom vyznat a co za tu cenu skutečně dostanete?',
    href: '/blog/kolik-stoji-webove-stranky',
    date: '2025-07-14',
    readingTime: '6 minut',
  },
];
---

<Layout
  title="Blog o tvorbě webových stránek | Hezké webovky"
  description="Praktické rady o webových stránkách pro firmy a živnostníky. Ceny, SEO, tipy jak získat zákazníky online."
  noLoader
>
  <Nav />
  <main class="pt-32 pb-24">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-text-muted text-xs tracking-[0.3em] uppercase mb-4">Blog</div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
        Praktické rady o <span class="text-accent">webech</span>
      </h1>
      <p class="text-text-secondary text-lg mb-16 max-w-xl">Tipy pro firmy a živnostníky — ceny, SEO a jak z webu získat zákazníky.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => (
          <a href={post.href} class="group block p-6 border border-dark-border rounded-2xl hover:border-accent/40 transition-all duration-300">
            <div class="flex items-center gap-3 text-xs text-text-muted mb-4">
              <time datetime={post.date}>{new Date(post.date).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              <span>·</span>
              <span>{post.readingTime}</span>
            </div>
            <h2 class="text-lg font-semibold mb-2 group-hover:text-accent transition-colors duration-300 leading-snug">{post.title}</h2>
            <p class="text-text-secondary text-sm leading-relaxed">{post.description}</p>
            <div class="mt-4 text-accent text-xs tracking-wider uppercase flex items-center gap-1">
              Číst článek
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
