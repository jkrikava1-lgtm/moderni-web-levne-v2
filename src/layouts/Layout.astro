---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noLoader?: boolean;
}

const { title, description = 'Tvorba webových stránek pro firmy, živnostníky a řemeslníky. Profesionální web na míru od 9 900 Kč, hotovo do 3 týdnů. Žádné měsíční poplatky, žádné šablony.', noLoader = false } = Astro.props;
const siteUrl = 'https://hezkewebovky.cz';
const ogImage = `${siteUrl}/og-image-v2.png`;
---

<!doctype html>
<html lang="cs">
  <head>
    <!-- Google Analytics with Consent Mode v2 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0RNN8D6XDS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Default: deny all until user consents
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });

      // Apply saved consent if exists
      var savedConsent = localStorage.getItem('cookie-consent');
      if (savedConsent === 'accepted') {
        gtag('consent', 'update', {
          'analytics_storage': 'granted'
        });
      }

      gtag('js', new Date());
      gtag('config', 'G-0RNN8D6XDS');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Hezké webovky" />
    <meta name="robots" content="index, follow" />
    <meta name="seznam-wmt" content="DjOnAjo8ks1uVCH3UahjOEJcLJfp8gdU" />
    <meta name="seznam-wmt" content="QJQXL1hY4eL54snsMbWlXMaLk7ClN3gw" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Hezké webovky" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts — non-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Nunito:wght@300;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Nunito:wght@300;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" /></noscript>

    <title>{title}</title>

    <!-- Structured Data: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Hezké webovky",
      "description": "Tvorba profesionálních webových stránek za férovou cenu. Weby na míru pro firmy, živnostníky a řemeslníky. Ceny od 9 900 Kč, hotovo do 3 týdnů.",
      "url": siteUrl,
      "telephone": "+420777724573",
      "email": "info@hezkewebovky.cz",
      "priceRange": "9 900 Kč – 50 000 Kč",
      "areaServed": { "@type": "Country", "name": "Česká republika" },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Webové služby",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tvorba webových stránek na míru" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Redesign webu" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO optimalizace" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Správa a údržba webu" } }
        ]
      },
      "sameAs": [
        "https://www.facebook.com/hezkewebovky",
        "https://www.instagram.com/hezkewebovky"
      ]
    })} />
    </script>

    <!-- Structured Data: FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Kolik stojí vytvoření webových stránek?", "acceptedAnswer": { "@type": "Answer", "text": "Cena za kompletní web začíná na 9 900 Kč. V ceně je návrh designu, programování, základní SEO optimalizace a nasazení. Přesnou cenu vždy dohodnu předem — žádné skryté poplatky." } },
        { "@type": "Question", "name": "Jak dlouho trvá vytvoření webu?", "acceptedAnswer": { "@type": "Answer", "text": "Standardní web hotový do 3 týdnů od schválení návrhu. Termín vždy dohodnu předem." } },
        { "@type": "Question", "name": "Pro koho weby tvořím?", "acceptedAnswer": { "@type": "Answer", "text": "Primárně pro živnostníky, řemeslníky a malé firmy, které potřebují profesionální web bez agenturnich cen — elektrikáři, instalatéři, restaurace, kosmetičky nebo e-shopy." } },
        { "@type": "Question", "name": "Co je součástí ceny webu?", "acceptedAnswer": { "@type": "Answer", "text": "Návrh a programování webu na míru, mobilní verze (responzivní design), základní SEO optimalizace, nasazení na server, zaškolení a podpora po spuštění." } },
        { "@type": "Question", "name": "Musím platit měsíční poplatky za web?", "acceptedAnswer": { "@type": "Answer", "text": "Ne. Platíte jednorázově za hotový web. Jediné pravidelné náklady jsou doména (cca 200 Kč/rok) a hosting (cca 500–1000 Kč/rok)." } },
        { "@type": "Question", "name": "Dělám e-shopy?", "acceptedAnswer": { "@type": "Answer", "text": "Ano, menší e-shopy dělám. Pro větší projekty s tisíci produktů doporučím vhodné řešení a pomohu s nastavením." } }
      ]
    })} />
    </script>
  </head>
  <body class="antialiased">
    <!-- Cookie consent banner -->
    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[9999] bg-dark-card border-t border-dark-border p-4 md:p-6 hidden">
      <div class="max-w-[1400px] mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <p class="text-text-secondary text-sm md:text-base max-w-2xl leading-relaxed">
          Tento web používá cookies pro analýzu návštěvnosti (Google Analytics).
          Můžete je přijmout nebo odmítnout.
        </p>
        <div class="flex gap-3 shrink-0">
          <button id="cookie-reject" class="px-5 py-2.5 border border-dark-border text-text-secondary text-sm rounded-lg hover:text-white hover:border-text-secondary transition-all">
            Odmítnout
          </button>
          <button id="cookie-accept" class="px-5 py-2.5 bg-accent text-black text-sm font-medium rounded-lg hover:bg-white transition-all">
            Přijmout
          </button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-banner');
        var saved = localStorage.getItem('cookie-consent');
        if (!saved) {
          banner.classList.remove('hidden');
        }
        document.getElementById('cookie-accept').addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'accepted');
          if (typeof gtag === 'function') {
            gtag('consent', 'update', { 'analytics_storage': 'granted' });
          }
          banner.classList.add('hidden');
        });
        document.getElementById('cookie-reject').addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'rejected');
          banner.classList.add('hidden');
        });
      })();
    </script>

    <!-- Loading screen — desktop only via JS -->
    {!noLoader && (
      <div class="loader" id="loader">
        <div class="loader-counter" id="loader-counter">0<span>%</span></div>
      </div>
    )}

    <!-- Custom cursor — desktop only, hidden via CSS on touch -->
    <div class="cursor-dot" id="cursor-dot"></div>
    <div class="cursor-ring" id="cursor-ring"></div>

    <slot />

    <!-- ALL JS EFFECTS — desktop only -->
    <script>
      const isDesktop = window.matchMedia('(pointer: fine)').matches;

      // === RANDOM GREEN WORD IN HEADINGS — mobile/tablet ===
      if (!isDesktop) {
        document.querySelectorAll('#sluzby h2, #cena h2, #ukazky h2, #jaknato h2, #kontakt h2').forEach((h2) => {
          const words = h2.textContent?.trim().split(/\s+/) || [];
          if (words.length > 1) {
            const idx = Math.floor(Math.random() * words.length);
            h2.innerHTML = words.map((w, i) => i === idx ? `<span class="accent-word">${w}</span>` : w).join(' ');
          }
        });
      }

      // === LOADER ===
      const loader = document.getElementById('loader');
      if (loader) {
        if (!isDesktop || window.location.hash) {
          loader.classList.add('hidden');
        } else {
          const counter = document.getElementById('loader-counter');
          let count = 0;
          const interval = setInterval(() => {
            count += Math.floor(Math.random() * 8) + 2;
            if (count >= 100) {
              count = 100;
              clearInterval(interval);
              if (counter) counter.innerHTML = `100<span>%</span>`;
              setTimeout(() => loader.classList.add('hidden'), 400);
            }
            if (counter) counter.innerHTML = `${count}<span>%</span>`;
          }, 40);
        }
      }

      // === LENIS SMOOTH SCROLL — desktop only ===
      if (isDesktop) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({
            duration: 1.2,
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          });
          function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);
        });
      }

      // === CUSTOM CURSOR — desktop only ===
      if (isDesktop) {
        const dot = document.getElementById('cursor-dot') as HTMLElement;
        const ring = document.getElementById('cursor-ring') as HTMLElement;
        let mouseX = 0, mouseY = 0;
        let ringX = 0, ringY = 0;

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (dot) { dot.style.left = mouseX + 'px'; dot.style.top = mouseY + 'px'; }
        });

        function animateRing() {
          ringX += (mouseX - ringX) * 0.12;
          ringY += (mouseY - ringY) * 0.12;
          if (ring) { ring.style.left = ringX + 'px'; ring.style.top = ringY + 'px'; }
          requestAnimationFrame(animateRing);
        }
        animateRing();

        document.querySelectorAll('a, button, [data-hover]').forEach((el) => {
          el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
          el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
        });
      }

      // === SCROLL REVEAL — desktop only ===
      if (isDesktop) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) entry.target.classList.add('visible');
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      // === PARALLAX on section headings — desktop only ===
      if (isDesktop) {
        const parallaxHeadings = document.querySelectorAll('h2');
        window.addEventListener('scroll', () => {
          parallaxHeadings.forEach((h2) => {
            const rect = h2.getBoundingClientRect();
            const speed = 0.08;
            const offset = (rect.top - window.innerHeight / 2) * speed;
            (h2 as HTMLElement).style.transform = `translateY(${offset}px)`;
          });
        });
      }

      // === MAGNETIC BUTTONS — desktop only ===
      if (isDesktop) {
        document.querySelectorAll('.magnetic-btn').forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const rect = (btn as HTMLElement).getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            (btn as HTMLElement).style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
          });
          btn.addEventListener('mouseleave', () => {
            (btn as HTMLElement).style.transform = 'translate(0, 0)';
          });
        });
      }
    </script>
  </body>
</html>
