---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  readingTime?: string;
}

const { title, description, publishDate, readingTime = '5 minut' } = Astro.props;
---

<Layout title={title} description={description} noLoader>
  <Nav />
  <main class="pt-32 pb-24">
    <div class="max-w-[740px] mx-auto px-4 md:px-8">

      <!-- Breadcrumb -->
      <nav class="text-xs text-text-muted mb-8 flex items-center gap-2">
        <a href="/" class="hover:text-accent transition-colors">Hezké webovky</a>
        <span>/</span>
        <a href="/blog" class="hover:text-accent transition-colors">Blog</a>
        <span>/</span>
        <span class="text-text-secondary">{title}</span>
      </nav>

      <!-- Header -->
      <header class="mb-12">
        <div class="flex items-center gap-4 text-xs text-text-muted mb-6">
          <time datetime={publishDate}>{new Date(publishDate).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          <span>·</span>
          <span>{readingTime} čtení</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight mb-6">
          {title}
        </h1>
        <p class="text-text-secondary text-lg md:text-xl leading-relaxed">
          {description}
        </p>
      </header>

      <div class="border-t border-dark-border mb-12"></div>

      <!-- Article body -->
      <article class="prose-blog">
        <slot />
      </article>

      <!-- CTA box -->
      <div class="mt-16 p-8 border border-accent/30 rounded-2xl bg-accent/5">
        <p class="text-xs tracking-[0.3em] uppercase text-accent mb-3">Připraveni začít?</p>
        <h2 class="text-2xl font-bold mb-3">Chcete web za férovou cenu?</h2>
        <p class="text-text-secondary mb-6">Napište mi — nezávazně probereme váš projekt a já připravím nabídku na míru.</p>
        <a href="/#kontakt" class="inline-flex px-6 py-3 bg-accent text-black font-semibold rounded-full text-sm hover:bg-white transition-all duration-300">
          Chci nezávaznou nabídku
        </a>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose-blog h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: white;
  }
  .prose-blog h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: white;
  }
  .prose-blog p {
    color: rgb(180 180 180);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .prose-blog ul, .prose-blog ol {
    color: rgb(180 180 180);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-blog li {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }
  .prose-blog strong {
    color: white;
    font-weight: 600;
  }
  .prose-blog a {
    color: #c8ff00;
    text-decoration: underline;
    text-decoration-color: rgba(200,255,0,0.3);
  }
  .prose-blog a:hover {
    text-decoration-color: #c8ff00;
  }
  .prose-blog table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  .prose-blog th {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    color: white;
    font-weight: 600;
  }
  .prose-blog td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    color: rgb(180 180 180);
  }
  .prose-blog tr:last-child td {
    border-bottom: none;
  }
  .prose-blog .highlight {
    background: rgba(200,255,0,0.08);
    border-left: 3px solid #c8ff00;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .prose-blog .highlight p {
    margin-bottom: 0;
  }
</style>
